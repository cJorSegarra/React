{
    "name": "post-front",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "prettier": "@goaigua/goaigua-config/config/prettier-config/prettier.json",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "format": "prettier --write --ignore-unknown",
