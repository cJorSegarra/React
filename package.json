        "lint:fix": "eslint --fix",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@goaigua/goaigua-config": "0.5.0-SNAPSHOT",
        "@reduxjs/toolkit": "^2.6.1",
        "@types/react-redux": "^7.1.34",
        "axios": "^1.8.4",
        "i18next": "^24.2.3",
        "jsencrypt": "^3.3.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^15.4.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.4.0",
        "sass": "^1.86.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "prettier": "2.8.8",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
